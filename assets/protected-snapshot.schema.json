{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected Manuscript Snapshot",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "source_path", "sha256", "created_at", "protected", "counts"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "protected": {
      "type": "object",
      "required": ["numbers", "citations", "variables", "latex_labels", "latex_refs", "locked_fragments"],
      "properties": {
        "numbers": {"type": "object"},
        "citations": {"type": "object"},
        "variables": {"type": "object"},
        "latex_labels": {"type": "array", "items": {"type": "string"}},
        "latex_refs": {"type": "array", "items": {"type": "string"}},
        "locked_fragments": {"type": "array", "items": {"type": "string"}},
        "equations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "counts": {"type": "object"}
  },
  "additionalProperties": true
}

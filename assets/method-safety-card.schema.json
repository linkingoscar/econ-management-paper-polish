{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/econ-management-paper-polish/method-safety-card.schema.json",
  "type": "object",
  "required": ["schema_version", "method_id", "method", "data_structure", "identifying_variation", "estimand", "assumptions", "diagnostics", "remaining_threats", "cannot_solve", "reporting_requirements", "authority_sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "method_id": {"type": "string", "pattern": "^MTH-[A-Z0-9_-]+$"},
    "method": {"type": "string", "minLength": 1},
    "language_scope": {"type": "array", "items": {"enum": ["en", "zh"]}},
    "data_structure": {"type": "string", "minLength": 1},
    "identifying_variation": {"type": "string", "minLength": 1},
    "estimand": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "diagnostics": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "remaining_threats": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "cannot_solve": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "suitable_routes": {"type": "array", "items": {"type": "string"}},
    "reporting_requirements": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "conservative_rewrite": {"type": "string", "minLength": 1},
    "authority_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "checked_at", "status"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "checked_at": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "documented", "needs-author-review"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

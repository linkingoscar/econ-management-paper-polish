{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v3.1 Capability Report",
  "type": "object",
  "required": ["schema_version", "run_id", "generated_at", "overall_mode", "checks", "permissions", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "overall_mode": {"type": "string", "enum": ["Verified", "Documented", "Conceptual"]},
    "checks": {"type": "array", "items": {"type": "object"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "output_ceiling": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}

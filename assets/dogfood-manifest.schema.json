{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/econ-management-paper-polish/dogfood-manifest.schema.json",
  "title": "Local Dogfood Manifest",
  "type": "object",
  "required": ["schema_version", "suite", "policy", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite": {"type": "string", "minLength": 1},
    "policy": {"const": "synthetic-fixtures-only"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "discipline", "language", "method", "expected_workflow"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "discipline": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "section": {"type": "string"},
          "expected_workflow": {"enum": ["pass", "fail"]},
          "expected_reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

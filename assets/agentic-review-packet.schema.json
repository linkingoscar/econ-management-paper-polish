{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/econ-management-paper-polish/agentic-review-packet.schema.json",
  "title": "Blind Agentic Review Packet",
  "type": "object",
  "required": ["schema_version", "packet_id", "case_id", "prompt", "risk_level", "source", "blind_variants", "rubric", "judge_policy", "judge_profiles", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "source": {"type": "object", "required": ["path", "sha256", "content"]},
    "blind_variants": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["blind_id", "sha256", "content"], "not": {"required": ["variant_id"]}}},
    "rubric": {"type": "array", "minItems": 1},
    "judge_policy": {"type": "object"},
    "judge_profiles": {"type": "array", "minItems": 3},
    "created_at": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/econ-management-paper-polish/agentic-review.schema.json",
  "title": "Isolated Agentic Benchmark Review",
  "type": "object",
  "required": ["schema_version", "review_id", "packet_id", "packet_sha256", "reviewer", "provenance", "raw_response", "scores", "pairwise", "confidence", "limitations", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "review_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {"type": "object", "required": ["kind", "reviewer_id", "provider", "model", "isolated_pass"]},
    "provenance": {"type": "object", "required": ["judge_profile_id", "request_id", "prompt_sha256", "raw_response_sha256", "attempt", "finish_reason"]},
    "raw_response": {"type": "string"},
    "scores": {"type": "array", "minItems": 2},
    "pairwise": {"type": "object", "required": ["verdict"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

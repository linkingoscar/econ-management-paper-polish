{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/econ-management-paper-polish/ai-review.schema.json",
  "title": "AI Writing Review",
  "type": "object",
  "required": ["schema_version", "review_id", "packet_id", "artifact_kind", "artifact_sha256", "risk_level", "reviewer", "verdict", "checks", "limitations", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "review_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "artifact_kind": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "reviewer": {
      "type": "object",
      "required": ["kind", "reviewer_id", "provider", "model", "isolated_pass"],
      "properties": {
        "kind": {"const": "ai"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "isolated_pass": {"const": true}
      },
      "additionalProperties": true
    },
    "verdict": {"enum": ["approve", "block", "escalate"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "status", "reason", "evidence"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "unknown"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}

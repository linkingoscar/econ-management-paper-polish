{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/econ-management-paper-polish/adversarial-mutation-report.schema.json",
  "title": "Adversarial Scholarly Mutation Report",
  "type": "object",
  "required": ["schema_version", "suite_id", "generator", "deterministic", "case_count", "mutation_count", "cases", "skipped", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"type": "string", "minLength": 1},
    "generator": {"type": "string", "minLength": 1},
    "deterministic": {"const": true},
    "case_count": {"type": "integer", "minimum": 1},
    "mutation_count": {"type": "integer", "minimum": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["case_id", "seed_id", "operator", "expected", "path", "source_sha256", "mutated_sha256"]}},
    "skipped": {"type": "array"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
